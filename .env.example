# Kopieren nach .env und anpassen.
# Datenbankpasswort frei wählen, z. B. mit: openssl rand -hex 16
POSTGRES_PASSWORD=
# Geheimer Schlüssel für SearXNG, z. B. openssl rand -hex 32
SEARXNG_SECRET=

# LM Studio auf oi-o-mat. Aus dem LAN (z. B. Proxmox-Container) über die feste IP,
# läuft Docker direkt auf oi-o-mat, geht auch http://host.docker.internal:1234/v1.
LLM_ENDPOINT=http://192.168.2.122:1234/v1
# Kleines Modell (≈ 7 GB), damit es neben Tonwerk/YuE2 Platz hat. Gleicher Schlüssel wie MODELS in der yue-guard-Konfiguration.
LLM_MODEL=gemma-4-e4b-it-mlx
# Optional ein eigenes, größeres Modell nur für die Fotoerkennung, z. B. gemma-4-26b-a4b-it-qat-mlx (≈ 16 GB).
# Achtung: Das passt nicht neben die großen Tonwerk-Modelle. Dann in der yue-guard-Konfiguration beide
# Modelle unter MODELS eintragen und PAUSE_FOR leer lassen, damit Ohmventory bei jeder Tonwerk-Arbeit weicht.
LLM_VISION_MODEL=
LLM_CONTEXT_LENGTH=8192
# Optional: Schlüssel für /api/llm/pause und /resume (Header X-Control-Token).
LLM_CONTROL_TOKEN=

WEB_PORT=8080
# Adresse, unter der das Handy die App erreicht. Wird in die QR-Codes der Container geschrieben.
PUBLIC_BASE_URL=http://192.168.1.10:8080
