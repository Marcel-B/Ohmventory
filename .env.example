# Kopieren nach .env und anpassen.
# Datenbankpasswort frei wählen, z. B. mit: openssl rand -hex 16
POSTGRES_PASSWORD=
# Geheimer Schlüssel für SearXNG, z. B. openssl rand -hex 32
SEARXNG_SECRET=

# LLM-Schranke auf oi-o-mat (scripts-Repo, docs/llm-gate.md). Nie LM Studio direkt (Port 1234).
# Aus dem LAN (z. B. Proxmox-Container) über die feste IP; läuft Docker direkt auf oi-o-mat,
# geht auch http://host.docker.internal:1235.
LLM_GATE_URL=http://192.168.2.122:1235
# Modell für Projektassistent und Websuche (≈ 7 GB). Muss in /gate für ohmventory freigegeben sein.
LLM_MODEL=gemma-4-e4b-it-mlx
# Modell für die Fotoerkennung; leer heißt gemma-4-26b-a4b-it-qat-mlx (≈ 16 GB, MoE mit 4B aktiven Parametern).
# Ebenfalls in /gate freigeben. Es passt nicht neben die großen Tonwerk-Modelle, daher weicht Ohmventory
# bei jeder Tonwerk-Arbeit (holdFor leer), und ramBudgetGb der Schranke muss mindestens etwa 20 sein.
LLM_VISION_MODEL=
LLM_CONTEXT_LENGTH=8192
# Optional: Schlüssel für /api/llm/pause und /resume (Header X-Control-Token). Nur nötig, wenn ein Pausenwächter sie aufruft.
LLM_CONTROL_TOKEN=

WEB_PORT=8080
# Adresse, unter der das Handy die App erreicht. Wird in die QR-Codes der Container geschrieben.
PUBLIC_BASE_URL=http://192.168.1.10:8080
