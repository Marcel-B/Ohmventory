# Kopieren nach .env und anpassen.
# Datenbankpasswort frei wählen, z. B. mit: openssl rand -hex 16
POSTGRES_PASSWORD=

# LM Studio (Developer > Local Server). Aus Docker heraus ist der Mac über host.docker.internal erreichbar.
LLM_ENDPOINT=http://host.docker.internal:1234/v1
LLM_VISION_MODEL=gemma-4-26b-a4b-it-qat-mlx
LLM_CHAT_MODEL=gemma-4-26b-a4b-it-qat-mlx

# Adresse, unter der das Handy die App erreicht. Wird in die QR-Codes der Container geschrieben.
PUBLIC_BASE_URL=http://192.168.1.10:8080
